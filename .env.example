# ==============================================================================
# Tether - Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (for local development) or set these in your production
#    container orchestration platform (Docker Swarm, Kubernetes, ECS, Nomad).
# 2. Never commit .env or secrets to version control.
# ==============================================================================

# --- Application Environment ---
# Options: development, test, production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Options: text (dev readable), json (production structured)
LOG_FORMAT=text

# --- Application Metadata ---
APP_NAME=Tether
APP_VERSION=1.0.0

# --- Database (PostgreSQL 16+) ---
# Production connection string format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Connection Pooling Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# --- Broker & Results Backend (Redis 7+) ---
REDIS_URL=redis://localhost:6379/0
CELERY_QUEUE=monitoring

# --- Security & JWT Authentication ---
# MUST be generated with: openssl rand -hex 32 (minimum 32 characters required in production)
SECRET_KEY=tether-insecure-dev-secret-key-change-in-production-long-random-string-12345
JWT_SECRET_KEY=tether-insecure-dev-secret-key-change-in-production-long-random-string-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- CORS Allowed Origins (Comma-separated list) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://tether.example.com

# --- Monitoring & Scheduling Engine ---
SCHEDULER_TICK_INTERVAL_SECONDS=5.0
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY_SECONDS=30.0
TARGET_LOCK_TTL_SECONDS=300

# --- Data Retention Policies (Days) ---
RESULT_RETENTION_DAYS=30
JOB_RETENTION_DAYS=14
ALERT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# --- Optional Production Observability ---
# Sentry DSN for centralized exception tracking (optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# OpenTelemetry Collector Endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# ENABLE_TRACING=false
