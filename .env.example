# ==============================================================================
# Tether - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure all required variables.
# Never commit real secrets to version control.
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# Application Metadata
APP_NAME=Tether
APP_VERSION=1.0.0

# Database (Neon PostgreSQL connection string)
DATABASE_URL=<required-neon-postgresql-url>

# Database Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Redis Broker & Locking (Upstash Redis or external Redis instance)
REDIS_URL=<required-upstash-redis-url>
CELERY_QUEUE=monitoring

# Security & Authentication (Generate with `openssl rand -hex 32`, min 32 chars)
SECRET_KEY=<required-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=30

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# Monitoring & Scheduling Engine
SCHEDULER_TICK_INTERVAL_SECONDS=5.0
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY_SECONDS=30.0
TARGET_LOCK_TTL_SECONDS=300

# Data Retention Policies (Days)
RESULT_RETENTION_DAYS=30
JOB_RETENTION_DAYS=14
ALERT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# Optional Observability Integrations
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# ENABLE_TRACING=false
